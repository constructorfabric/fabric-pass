DATABASE_URL=postgresql://localhost:5432/contributor_registry
# At least 32 characters. Generate with: openssl rand -base64 32
SESSION_PASSWORD=
APP_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Shared secrets for the cf-internal contributors registry sync — generate
# with: openssl rand -hex 32
CONTRIBUTORS_EXPORT_SECRET=
CONTRIBUTORS_SYNC_SECRET=
# Shared secret for the cf-internal tracks sync (pass/tracks.yaml -> DB,
# one-way) — generate with: openssl rand -hex 32
TRACKS_SYNC_SECRET=
# Shared secrets for the cf-internal artifact-links and track-page-template
# syncs (pass/artifact-links.yaml, pass/track-page.md -> DB, both one-way) —
# generate with: openssl rand -hex 32
ARTIFACT_LINKS_SYNC_SECRET=
TRACK_PAGE_TEMPLATE_SYNC_SECRET=
# Shared secret for the cf-internal config sync (pass/config.yaml -> DB,
# one-way) — generate with: openssl rand -hex 32
CONFIG_SYNC_SECRET=
# Shared secret guarding the track-members export (DB -> cf-internal's
# pass/track-members.yaml, one-way, the export direction only) — generate
# with: openssl rand -hex 32
TRACK_MEMBERS_EXPORT_SECRET=
# Optional — see lib/email.ts. With RESEND_API_KEY unset, a confirmation
# email is logged instead of sent, so local dev works with neither of these
# set. RESEND_FROM_ADDRESS defaults to no-reply@cfabric.org.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
# Optional — see lib/providers/index.ts. This app's only optional provider:
# with both unset, the LinkedIn row is hidden from the profile form and
# /auth/linkedin 404s. Setting only one fails env validation at boot — it's
# both or neither.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional — the numeric GitHub id of this app's single root user. Unset
# means no root user at all. Always an Admin, on top of whatever is_admin
# says — see lib/roles.ts.
ROOT_GITHUB_ID=
# Optional — see lib/droplet-metrics.ts. With both unset, the Admin-only
# footer status section (IDEA-028) doesn't render at all. DO_API_TOKEN is a
# read-only DigitalOcean API token (generate at
# https://cloud.digitalocean.com/account/api/tokens); DO_DROPLET_ID is the
# production droplet's numeric id. Setting only one fails env validation at
# boot — it's both or neither.
DO_API_TOKEN=
DO_DROPLET_ID=
# Optional and independent of each other — see lib/github-org.ts and
# lib/discord-role.ts. GITHUB_ORG_TOKEN needs `admin:org` scope (org invite
# + team membership); DISCORD_BOT_TOKEN needs the bot invited into the
# guild with Manage Roles, positioned above every role it's asked to grant.
# With either unset, that half of the auto-invite/auto-add feature
# (IDEA-041/042) silently no-ops and logs why.
GITHUB_ORG_TOKEN=
DISCORD_BOT_TOKEN=
