# Build-time configuration for Fabric Pass (see src/core/config.ts).
# Copy this file to `.env` and adjust locally — none of this is secret, it's just
# per-developer setup (e.g. pointing at a local pass instance).

# Origin of the Fabric Pass instance the extension talks to. Also used to compute
# `host_permissions` in wxt.config.ts, so a non-default value here needs a rebuild
# to take effect on the manifest too. Default: https://pass.cfabric.org
WXT_PASS_ORIGIN=https://pass.cfabric.org

# How many days without a successful authorized pass response before the whole pass
# cache is wiped (see sweepExpired). Default: 3
WXT_PASS_MAX_CACHE_AGE_DAYS=3

# How many hours a positive cache entry (a known name) stays fresh before it's asked
# for again. Default: 24
WXT_PASS_ENTRY_TTL_HOURS=24

# How many hours a negative cache entry (a login pass doesn't know) stays fresh
# before it's asked for again. Default: 24
WXT_PASS_MISS_TTL_HOURS=24
